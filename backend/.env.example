# Server Configuration
PORT=5000

# Database Connection (MongoDB URI)
MONGO_URI=mongodb://localhost:27017/project_management_db

# JSON Web Token Secret
JWT_SECRET=

# Initial administrator account (required when no admin exists)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (create a bucket-scoped Object Read & Write S3 API token)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=project-management-system-reports
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
