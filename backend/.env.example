# Server Configuration
PORT=5000

# Database Connection (MongoDB URI)
MONGO_URI=mongodb://localhost:27017/project_management_db

# JSON Web Token Secret
JWT_SECRET=

# Initial administrator account (required when no admin exists)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (from your Cloudinary Dashboard > Account Details)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
